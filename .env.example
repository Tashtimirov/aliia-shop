# Supabase (без них витрина работает на демо-данных)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Токен бота: проверка входа из Telegram Mini App
TELEGRAM_BOT_TOKEN=
# Доставка: СДЭК API v2 (ключи из ЛК СДЭК → Интеграция). Без них отслеживание СДЭК выключено.
CDEK_API_URL=https://api.edu.cdek.ru/v2
CDEK_CLIENT_ID=
CDEK_CLIENT_SECRET=
# Секрет в URL вебхука СДЭК и для cron-опроса
CDEK_WEBHOOK_SECRET=
CRON_SECRET=
