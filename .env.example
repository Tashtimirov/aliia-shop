# Supabase (без них витрина работает на демо-данных)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Токен бота: проверка входа из Telegram Mini App
TELEGRAM_BOT_TOKEN=
# CRM (/admin): вход из Telegram по списку админов (ADMIN_IDS через запятую и settings.admins)
# или на сайте по паролю. Секрет подписи сессии; если не задан, берётся производный от SUPABASE_SERVICE_ROLE_KEY.
ADMIN_IDS=
CRM_ADMIN_PASSWORD=
CRM_SESSION_SECRET=
