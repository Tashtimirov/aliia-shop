# Токен от @BotFather
TELEGRAM_BOT_TOKEN=
# Telegram id Алии (и Ильдара) через запятую. Узнать свой id: написать боту /id
ADMIN_IDS=
# Куда приходят новые заказы: id Алии или закрытой группы (у групп id с минусом). По умолчанию первый из ADMIN_IDS
ADMIN_CHAT_ID=
# Ссылка на каталог (Telegram Mini App / сайт). Пока каталога нет, оставьте пустым
WEBAPP_URL=
# Что клиент видит после подтверждения суммы
PAYMENT_DETAILS=Перевод по номеру +7 XXX XXX-XX-XX (Сбербанк, Алия Т.). После оплаты нажмите «Я оплатил(а)».
CHANNEL_URL=https://t.me/fromthailand_rus
# Supabase (общая база сервиса). Если пусто, бот хранит всё в локальном файле DATA_FILE
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DATA_FILE=data.json
